# Konten und Synchronisierung (optional). Ohne diese Werte läuft die Website wie bisher ohne Konten.
# Werte aus dem Supabase-Dashboard: Project Settings → API. Der anon-Schlüssel ist öffentlich;
# geschützt werden die Daten durch Row Level Security (supabase/migrations).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Zusätzliche Anmeldewege, kommagetrennt: google, apple (jeweils in Supabase unter Authentication → Providers einrichten)
VITE_AUTH_PROVIDERS=
